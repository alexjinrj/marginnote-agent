{
  "name": "marginnote-agent",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "description": "Local MarginNote MCP bridge for Codex",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node host/src/bridge-main.mjs",
    "install:launch-agent": "node scripts/install-launch-agent.mjs",
    "test": "node --test host/test/*.test.mjs mcp/test/*.test.mjs",
    "build:addon": "node scripts/build-addon.mjs",
    "verify:addon": "node scripts/verify-addon.mjs",
    "verify": "node --test host/test/*.test.mjs mcp/test/*.test.mjs && node scripts/build-addon.mjs && node scripts/verify-addon.mjs",
    "mcp": "node mcp/src/index.mjs",
    "smoke": "node scripts/smoke-bridge.mjs",
    "smoke:card": "node scripts/smoke-current-card.mjs",
    "smoke:pdf": "node scripts/smoke-current-pdf.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "3.25.76"
  }
}
